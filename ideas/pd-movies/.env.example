# Copy to .env and fill in. Used only by build-data.mjs at author time —
# .env is gitignored and no key ever reaches the browser or data.json.

# thetvdb.com -> account -> API keys (v4). PIN only for user-supported keys.
TVDB_API_KEY=
TVDB_PIN=

# fanart.tv -> your project's personal API key.
FANART_API_KEY=
